{
  "Complete JWT Boilerplate": {
    "prefix": "jwtgo",
    "body": [
      "package auth",
      "",
      "import (",
      "\t\"errors\"",
      "\t\"fmt\"",
      "\t\"log\"",
      "\t\"net/http\"",
      "\t\"os\"",
      "\t\"time\"",
      "",
      "\t\"github.com/golang-jwt/jwt/v5\"",
      ")",
      "",
      "func getJWTSecret() []byte {",
      "\tsecret := os.Getenv(\"JWT_SECRET\")",
      "\tif secret == \"\" {",
      "\t\tlog.Println(\"WARNING: JWT_SECRET environment variable not set. Using fallback development key.\")",
      "\t\treturn []byte(\"${1:dev_fallback_secure_signing_key}\")",
      "\t}",
      "\treturn []byte(secret)",
      "}",
      "",
      "type CustomClaims struct {",
      "\tUserID string `json:\"user_id\"`",
      "\tRole   string `json:\"role\"`",
      "\tjwt.RegisteredClaims",
      "}",
      "",
      "func GenerateToken(userID string, role string) (string, error) {",
      "\texpirationTime := time.Now().Add(${2:2} * time.Hour)",
      "\tclaims := &CustomClaims{",
      "\t\tUserID: userID,",
      "\t\tRole:   role,",
      "\t\tRegisteredClaims: jwt.RegisteredClaims{",
      "\t\t\tExpiresAt: jwt.NewNumericDate(expirationTime),",
      "\t\t\tIssuedAt:  jwt.NewNumericDate(time.Now()),",
      "\t\t\tNotBefore: jwt.NewNumericDate(time.Now()),",
      "\t\t\tIssuer:    \"${3:my-go-backend}\",",
      "\t\t},",
      "\t}",
      "\ttoken := jwt.NewWithClaims(jwt.SigningMethodHS256, claims)",
      "\ttokenString, err := token.SignedString(getJWTSecret())",
      "\tif err != nil {",
      "\t\treturn \"\", fmt.Errorf(\"failed to sign token: %w\", err)",
      "\t}",
      "\treturn tokenString, nil",
      "}",
      "",
      "func ValidateToken(tokenString string) (*CustomClaims, error) {",
      "\ttoken, err := jwt.ParseWithClaims(tokenString, &CustomClaims{}, func(token *jwt.Token) (interface{}, error) {",
      "\t\tif _, ok := token.Method.(*jwt.SigningMethodHMAC); !ok {",
      "\t\t\treturn nil, fmt.Errorf(\"unexpected signing method: %v\", token.Header[\"alg\"])",
      "\t\t}",
      "\t\treturn getJWTSecret(), nil",
      "\t})",
      "\tif err != nil {",
      "\t\treturn nil, err",
      "\t}",
      "\tif claims, ok := token.Claims.(*CustomClaims); ok && token.Valid {",
      "\t\treturn claims, nil",
      "\t}",
      "\treturn nil, errors.New(\"invalid authentication token\")",
      "}",
      "",
      "func JWTMiddleware(next http.HandlerFunc) http.HandlerFunc {",
      "\treturn func(w http.ResponseWriter, r *http.Request) {",
      "\t\tauthHeader := r.Header.Get(\"Authorization\")",
      "\t\tif len(authHeader) < 8 || authHeader[:7] != \"Bearer \" {",
      "\t\t\thttp.Error(w, \"Unauthorized: Missing or malformed token\", http.StatusUnauthorized)",
      "\t\t\treturn",
      "\t\t}",
      "\t\ttokenString := authHeader[7:]",
      "\t\tclaims, err := ValidateToken(tokenString)",
      "\t\tif err != nil {",
      "\t\t\tlog.Printf(\"JWT Validation Error: %v\", err)",
      "\t\t\thttp.Error(w, \"Unauthorized: Invalid token\", http.StatusUnauthorized)",
      "\t\t\treturn",
      "\t\t}",
      "\t\tr.Header.Set(\"X-User-ID\", claims.UserID)",
      "\t\tr.Header.Set(\"X-User-Role\", claims.Role)",
      "\t\tnext.ServeHTTP(w, r)",
      "\t}",
      "}"
    ],
    "description": "Production ready JWT boilerplate architecture using golang-jwt/jwt/v5"
  },
  "HTTP Secure Error Handler": {
    "prefix": "herr",
    "body": [
      "if err != nil {",
      "\tlog.Printf(\"${1:failed operation}: %v\", err)",
      "\thttp.Error(w, \"${2:Internal Server Error}\", http.StatusInternalServerError)",
      "\treturn",
      "}"
    ],
    "description": "Secure HTTP error handler that logs internally"
  },
  "Simple Return Error": {
    "prefix": "ier",
    "body": ["if err != nil {", "\treturn err", "}"],
    "description": "Standard if err != nil { return err }"
  },
  "Wrap and Return Error": {
    "prefix": "ierw",
    "body": [
      "if err != nil {",
      "\treturn fmt.Errorf(\"${1:failed to execute}: %w\", err)",
      "}"
    ],
    "description": "Return error wrapped with structural context"
  },
  "Inline Function Error Check": {
    "prefix": "iif",
    "body": ["if err := ${1:function()}; err != nil {", "\treturn err", "}"],
    "description": "Inline assignment and error check"
  },
  "Panic On Error": {
    "prefix": "iep",
    "body": ["if err != nil {", "\tpanic(err)", "}"],
    "description": "Standard if err != nil { panic(err) }"
  },
  "Log Error and Continue": {
    "prefix": "iel",
    "body": ["if err != nil {", "\tlog.Printf(\"${1:warning}: %v\", err)", "}"],
    "description": "Log the error without breaking execution flow"
  }
}
